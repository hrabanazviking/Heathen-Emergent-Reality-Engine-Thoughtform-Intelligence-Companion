{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "H.E.R.E.T.I.C.",
  "identifier": "io.heretic.app",
  "version": "0.4.1",
  "build": {
    "frontendDist": "../frontend/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "cd ../frontend && npm run dev",
    "beforeBuildCommand": "cd ../frontend && npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "summoning-circle",
        "title": "H.E.R.E.T.I.C.",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "alwaysOnTop": false,
        "theme": "Dark",
        "backgroundColor": "#0a0c10",
        "center": true,
        "url": "index.html"
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "resources": [],
    "externalBin": [],
    "copyright": "",
    "category": "Utility",
    "shortDescription": "AI ceremony interface",
    "longDescription": "H.E.R.E.T.I.C. — Host Environment for Realtime Embodiment, Tooling and Interactive Control. Summoning Circle native desktop shell.",
    "windows": {
      "digestAlgorithm": "sha256",
      "certificateThumbprint": null,
      "timestampUrl": ""
    },
    "macOS": {
      "entitlements": null,
      "exceptionDomain": "",
      "signingIdentity": null,
      "providerShortName": null
    },
    "linux": {
      "deb": {
        "depends": []
      }
    }
  },
  "plugins": {
    "single-instance": {
      "plugin": {}
    },
    "log": {
      "level": "info",
      "targets": [
        {
          "kind": "Stdout"
        },
        {
          "kind": "LogDir",
          "fileName": "heretic"
        }
      ]
    }
  }
}
